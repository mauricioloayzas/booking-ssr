# URLs base de los backends de Clichín (mismos que usa caja-registradora/frontend)
NUXT_PUBLIC_API_AUTH_BASE=
NUXT_PUBLIC_API_APOTHECA_BASE=
NUXT_PUBLIC_API_PROFESSIONALIS_BASE=
NUXT_PUBLIC_API_COLLECTOR_BASE=

# Site key de reCAPTCHA v3 (mismo sitio que usa caja-registradora/frontend; agrega el
# dominio de este SSR en la consola de Google reCAPTCHA para que el token sea válido aquí)
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Dominio público final de este SSR (para canonical/OG/sitemap)
NUXT_PUBLIC_SITE_URL=https://clichin.com

# URL del bucket S3 / CDN donde se suben los assets estáticos del build (build-time)
NUXT_APP_CDN_URL=
